# Copy to .env.local (never commit real values). Set the same keys in Vercel > Settings > Environment Variables.

# Neon connection string (Neon dashboard > Connect). Used by /api/app and the db scripts.
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URIs:
#   http://localhost:5173/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Existing
TMDB_API_KEY=

# Only for the one-time data move (npm run migrate:neon). Supabase > Connect > Session pooler.
SUPABASE_DB_URL=
